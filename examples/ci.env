# A value for every variable the valid example configs read, for
# `dataferry validate` in CI (scripts/check-examples.sh). The hosts are
# TEST-NET-1 (RFC 5737), so a validate that tried to connect would hang
# instead of passing. A new example's variables go here.
FERRY_GOLDEN_MONGO_URL=mongodb://192.0.2.1:27017
FERRY_GOLDEN_PG_URL=postgres://ferry@192.0.2.1:5432/warehouse
FERRY_GOLDEN_PG_SOURCE_URL=postgres://ferry@192.0.2.1:5432/shop
APP_DATABASE_URL=postgres://ferry@192.0.2.1:5432/app
REPORTING_DATABASE_URL=postgres://ferry@192.0.2.1:5432/reporting
FERRY_EDGE_APP_URL=postgres://ferry@192.0.2.1:5432/app
FERRY_EDGE_REPORTING_URL=postgres://ferry@192.0.2.1:5432/reporting
