# A value for every variable the guide's example configs read, for
# `validate` in docs/scripts/check-snippets.sh. The hosts are TEST-NET-1
# (RFC 5737), so a validate that tried to connect would hang instead of
# passing. A new example's variables go here.
CATALOG_MONGO_URL=mongodb://192.0.2.1:27017
CATALOG_PG_URL=postgres://ferry@192.0.2.1:5432/catalog
SIGNUPS_MONGO_URL=mongodb://192.0.2.1:27017
SIGNUPS_PG_URL=postgres://ferry@192.0.2.1:5432/signups
LEGACY_URL=postgres://ferry@192.0.2.1:5432/legacy
WAREHOUSE_URL=postgres://ferry@192.0.2.1:5432/warehouse
WAREHOUSE_PW=not-a-real-password
